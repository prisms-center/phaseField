set mesh type = rectangular

subsection Rectangular mesh
  set x size = 1.0
  set y size = 0.5
  set x periodic = true
end

set global refinement = 8
set mesh adaptivity   = false

subsection boundary conditions: 0
  set variables = n
  set conditions = Periodic, Periodic, Dirichlet, Dirichlet
end

set time step = 1.0e-3
set final time = 8.0

subsection output
  set condition = EQUAL_SPACING
  set number = 50
end
