subsection Rectangular mesh
  set x lower bound = 0.0
  set y lower bound = -0.05
  set z lower bound = 0.0
  set x size = 0.1
  set y size = 0.1
  set z size = 3.125e-3
  set x subdivisions = 32
  set y subdivisions = 32
  set z subdivisions = 1
end

set global refinement = 2
set time step = 1.0
set number steps = 300

subsection output
  set condition = EQUAL_SPACING
  set number = 5
end

subsection boundary conditions: 0
  set variables      = u:x, u:y, u:z
  # Six conditions for the six faces of a 3D box (x-lo, x-hi, y-lo, y-hi, z-lo, z-hi).
  # At dim==2 only the first four conditions are used; u:z and the last two are ignored.
  #
  # All-Dirichlet (current): applies the K-field on all faces including the z-normal
  # (front/back) faces, with u:z = 0.  Matches the generalized-plane-strain idealization
  # (infinite slab extruded uniformly in z).
  #
  # Traction-free alternative for the z-normal faces: replace the last two Dirichlet
  # with Natural to allow Poisson contraction and model a finite-thickness plate with
  # free surfaces.  This introduces 3D edge effects near the z faces:
  #   set conditions = Dirichlet, Dirichlet, Dirichlet, Dirichlet, Natural, Natural
  set conditions     = Dirichlet, Dirichlet, Dirichlet, Dirichlet, Dirichlet, Dirichlet
  set time dependent = true
end

subsection linear solver parameters: 0
  set solver_ids          = 2
  set max iterations      = 1000
  set tolerance type      = AbsoluteResidual
  set tolerance value     = 1e-5
  set preconditioner type = Chebyshev
  subsection Chebyshev
    set smoothing range          = 20
    set smoother degree          = 5
    set eigenvalue cg iterations = 20
  end
end

set Model constant cracklength = 0.01, double
set Model constant Mn          = 2e-5, double
set Model constant ell         = 3.75e-3, double
set Model constant Gc0         = 3.0, double
set Model constant CIJ_base    = (3e3,0.35), isotropic elastic constants
set Model constant vel_nom     = 2e-5, double
set Model constant KI_nom      = 103, double
